{
  "_comment": "Week 3 골든 데이터셋. unit(LLM 없음)과 agent(LLM 필요) 두 계층으로 구분.",

  "unit": [
    {
      "id": "save_ok",
      "tier": "main",
      "desc": "구조화된 요청을 SQLite에 저장하면 ok=True 와 request_id가 반환된다",
      "tool": "save_structured_request",
      "input": {
        "kind": "personal_schedule",
        "title": "팀 미팅",
        "date": "2026-07-16",
        "start_time": "10:00",
        "end_time": "11:00",
        "members": ["철수"],
        "original_text": "내일 10시 팀 미팅 저장해줘"
      },
      "expect": {
        "ok": true,
        "tool_name": "save_structured_request",
        "has_field": "request_id"
      }
    },
    {
      "id": "save_minimal",
      "tier": "main",
      "desc": "title만 있고 날짜/시간이 없어도 저장된다 (None 필드 허용)",
      "tool": "save_structured_request",
      "input": {
        "kind": "todo",
        "title": "보고서 제출",
        "original_text": "보고서 제출해야 해"
      },
      "expect": {
        "ok": true,
        "has_field": "request_id"
      }
    },
    {
      "id": "list_returns_saved",
      "tier": "main",
      "desc": "저장 후 list_saved_requests 로 조회하면 저장한 항목이 rows 안에 있다",
      "tool": "list_saved_requests",
      "pre_save": {
        "kind": "personal_schedule",
        "title": "조회 테스트 일정",
        "date": "2026-07-20",
        "original_text": "test"
      },
      "input": {
        "kind": "personal_schedule"
      },
      "expect": {
        "ok": true,
        "rows_min_count": 1,
        "rows_contains_title": "조회 테스트 일정"
      }
    },
    {
      "id": "get_single",
      "tier": "main",
      "desc": "저장 후 반환된 request_id 로 단건 조회하면 row 가 None 이 아니다",
      "tool": "get_saved_request",
      "pre_save": {
        "kind": "reminder",
        "title": "단건 조회 테스트",
        "original_text": "test"
      },
      "input": "use_saved_request_id",
      "expect": {
        "ok": true,
        "row_not_null": true,
        "row_contains_title": "단건 조회 테스트"
      }
    },
    {
      "id": "get_nonexistent",
      "tier": "main",
      "desc": "없는 request_id 로 조회해도 예외 없이 row=None 을 반환한다",
      "tool": "get_saved_request",
      "input": {
        "request_id": "req_does_not_exist_00000"
      },
      "expect": {
        "ok": true,
        "row_is_null": true
      }
    },
    {
      "id": "schedule_list_kind_filter",
      "tier": "main",
      "desc": "personal_list_saved_schedules 는 기본으로 personal_schedule 만 반환한다",
      "tool": "personal_list_saved_schedules",
      "pre_save": {
        "kind": "personal_schedule",
        "title": "일정 목록 테스트",
        "date": "2026-07-22",
        "original_text": "test"
      },
      "input": {},
      "expect": {
        "ok": true,
        "all_rows_kind": "personal_schedule"
      }
    },
    {
      "id": "delete_no_condition_rejected",
      "tier": "extra",
      "desc": "조건 없이 삭제 요청하면 ok=False 로 거부된다 (안전 가드)",
      "tool": "personal_delete_saved_schedules",
      "input": {},
      "expect": {
        "ok": false
      }
    },
    {
      "id": "delete_by_id",
      "tier": "extra",
      "desc": "저장 후 schedule_ids 로 삭제하면 deleted_count=1 이고 이후 목록에 없다",
      "tool": "personal_delete_saved_schedules",
      "pre_save": {
        "kind": "personal_schedule",
        "title": "삭제 테스트 일정",
        "date": "2026-07-25",
        "original_text": "test"
      },
      "input": "use_saved_schedule_id",
      "expect": {
        "ok": true,
        "deleted_count_min": 1,
        "has_field": "deleted"
      }
    },
    {
      "id": "update_title",
      "tier": "extra",
      "desc": "schedule_id 로 title 을 수정하면 updated_schedule 에 새 title 이 반영된다",
      "tool": "personal_update_saved_schedule",
      "pre_save": {
        "kind": "personal_schedule",
        "title": "수정 전 제목",
        "date": "2026-07-28",
        "original_text": "test"
      },
      "input": {
        "title": "수정 후 제목"
      },
      "input_id": "use_saved_schedule_id",
      "expect": {
        "ok": true,
        "updated_title": "수정 후 제목"
      }
    }
  ],

  "agent": [
    {
      "id": "agent_save_flow",
      "tier": "main",
      "desc": "자연어 저장 요청 → extract_schedule_request → save_structured_request 순서로 tool 이 호출된다",
      "input": "내일 오전 10시에 개인 코칭 저장해줘",
      "expect_tool_sequence": ["extract_schedule_request", "save_structured_request"],
      "expect_saved_fields": {
        "kind": "personal_schedule",
        "start_time": "10:00"
      }
    },
    {
      "id": "agent_list_flow",
      "tier": "main",
      "desc": "일정 조회 요청 → personal_list_saved_schedules 가 호출된다",
      "input": "내 일정 보여줘",
      "expect_tool_called": "personal_list_saved_schedules"
    },
    {
      "id": "agent_todo_save",
      "tier": "main",
      "desc": "할 일 요청은 kind=todo 로 저장된다",
      "input": "이번 주 안에 보고서 제출해야 해 기록해줘",
      "expect_tool_sequence": ["extract_schedule_request", "save_structured_request"],
      "expect_saved_fields": {
        "kind": "todo"
      }
    },
    {
      "id": "agent_delete_flow",
      "tier": "extra",
      "desc": "삭제 요청 → personal_list_saved_schedules 로 후보 확인 → personal_delete_saved_schedules 순서",
      "input": "저장된 코칭 일정 삭제해줘",
      "expect_tool_called": "personal_delete_saved_schedules"
    }
  ]
}
